# 실제 값은 여기(.env.example)에 적지 말고, .env 파일이나 Railway Variables에 넣으세요.
# 이 파일은 "어떤 값이 필요한지"만 보여주는 자리표시자 예시입니다.

BOT_TOKEN=여기에_실제_봇_토큰
DB_PATH=/data/photo_bot.db

# 아래 두 개는 선택 사항입니다. 비워두면 코드 안의 기본 문구/전체 허용이 사용됩니다.
MENTION_MESSAGE=여기에_최종_점검_멘트
REMINDER_MESSAGE=여기에_자정_리마인드_멘트

# 이 봇이 활동할 그룹의 chat_id (쉼표로 여러 개 가능). 비워두면 모든 그룹에서 동작합니다.
# chat_id 확인법: 그룹에서 "현황"을 쳐보면 관리자 응답 메시지 등으로 확인 가능하거나,
# 봇을 그룹에 추가한 직후 로그에서 확인할 수 있습니다.
ALLOWED_CHAT_IDS=
